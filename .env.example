# --- Base de datos (docker compose) ---
DATABASE_URL=postgresql://rag:rag@localhost:5432/rag

# --- OpenAI ---
OPENAI_API_KEY=
# Modelo que redacta las respuestas (router de Mastra: proveedor/modelo)
CHAT_MODEL=openai/gpt-5.4-mini
# Modelo con visión que describe las capturas durante la ingesta
VISION_MODEL=gpt-4.1-mini
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536
WHISPER_MODEL=whisper-1
# Transcribir con Whisper los vídeos sin subtítulos (si no, quedan como no_subtitles)
WHISPER_FALLBACK=false

# --- API ---
# Clave que debe enviar vuestro backend: Authorization: Bearer <clave>
RAG_SERVICE_KEY=
# URL con la que el cliente verá las capturas (/frames/...)
PUBLIC_BASE_URL=http://localhost:4111
SEARCH_TOP_K=8
MIN_SIMILARITY=0.35
MAX_SOURCES=3
MEMORY_LAST_MESSAGES=20

# --- Ingesta ---
CHANNEL_URL=https://www.youtube.com/@ofimedic
FRAMES_DIR=./data/frames
WORK_DIR=./data/work
CHUNK_WINDOW_SEC=45
CHUNK_OVERLAP_SEC=10
FRAME_OFFSET_SEC=4
MAX_ATTEMPTS=3
YTDLP_BIN=yt-dlp
# Fichero cookies.txt de una cuenta con acceso al canal, si YouTube pide "Sign in to confirm you're not a bot"
YTDLP_COOKIES=
YTDLP_JS_RUNTIME=node
FFMPEG_BIN=ffmpeg
