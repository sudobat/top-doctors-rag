{
  "name": "ofimedic-tutorials-rag",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build",
    "start": "node .mastra/output/index.mjs",
    "ingest": "tsx src/ingest/cli.ts",
    "db:migrate": "tsx src/db/migrate-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:db": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgresql://rag:rag@localhost:5432/rag_test} vitest run"
  },
  "dependencies": {
    "@mastra/core": "^1.80.0",
    "@mastra/memory": "^1.39.1",
    "@mastra/pg": "^1.33.0",
    "dotenv": "^18.0.9",
    "openai": "^7.45.1",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "^8.23.1",
    "ai": "^6.0.317",
    "mastra": "^1.36.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
